# Application

APP_NAME=secure-cloud-native-banking-platform
APP_ENV=development
APP_PORT=8080

# Database

DB_HOST=localhost
DB_PORT=5432
DB_NAME=banking
DB_USERNAME=banking_user
DB_PASSWORD=change_me

# PostgreSQL

POSTGRES_DB=banking
POSTGRES_USER=banking_user
POSTGRES_PASSWORD=change_me

# Security

JWT_SECRET=change_this_to_a_secure_random_secret
JWT_EXPIRATION=3600000

# Logging

LOG_LEVEL=INFO

# CORS

CORS_ALLOWED_ORIGINS=http://localhost:3000


# Keycloak
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=change_me_keycloak

# Optional local frontend API override
VITE_API_URL=/api
